[Unit]
Description=Odyssey isolated DEV runtime
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ragdehl/projects/odyssey-dev
EnvironmentFile=/home/ragdehl/.config/odyssey/secrets.env
ExecStart=/home/ragdehl/projects/odyssey-dev/scripts/odyssey-dev runtime
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/data/odyssey-dev
Environment=ODYSSEY_VAULT_ROOT=/data/odyssey-dev/vault
Environment=ODYSSEY_STATE_ROOT=/data/odyssey-dev/state
Environment=ODYSSEY_PENDING_ROOT=/data/odyssey-dev/state/pending
Environment=ODYSSEY_RUNTIME_ROOT=/data/odyssey-dev/runtime
Environment=ODYSSEY_EMBEDDING_CACHE=/data/odyssey-dev/runtime/embedding-cache
Environment=ODYSSEY_SCHEMA_PATH=/home/ragdehl/projects/odyssey-dev/config/note-schema.json
Environment=ODYSSEY_RUNTIME_HOST=127.0.0.1
Environment=ODYSSEY_RUNTIME_PORT=28765
Environment=ODYSSEY_ACTOR=odyssey-dev
Environment=ODYSSEY_ENABLED_APPLICATIONS=tasks,events
Environment=ODYSSEY_LIGHT_SOURCE_V1=1
Environment=ODYSSEY_DEPLOYMENT_ENV=DEV
# DEV-only: keep ONNX hot for a user session to avoid repeated 2-3s cold starts.
# Temporary UX-first compromise; investigate smaller multilingual models.
Environment=ODYSSEY_EMBEDDING_SUBPROCESS=1
Environment=ODYSSEY_EMBEDDING_IDLE_SECONDS=900
Environment=ODYSSEY_HYBRID_DEV_ENABLED=1
Environment=ODYSSEY_HYBRID_SOURCE_REVIEW_ENABLED=1
Environment=ODYSSEY_PARALLEL_ROUTE_PREPARATION=1
Environment=ODYSSEY_CONTEXTUAL_MODEL=gpt-6-luna
Environment=ODYSSEY_SEMANTIC_SET_MODEL=gpt-6-luna
Environment=TZ=Europe/Paris

[Install]
WantedBy=default.target
