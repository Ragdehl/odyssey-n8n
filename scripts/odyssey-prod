#!/usr/bin/env bash
set -euo pipefail

# Production promotion is deliberately explicit. This operator never manages n8n or cloudflared.
PROD_USER=ragdehl
PROD_REPOSITORY=/home/ragdehl/projects/odyssey
PROD_RELEASE=/home/ragdehl/projects/odyssey-prod-release
PROD_ROOT=/data/odyssey
PROD_VAULT=$PROD_ROOT/vault
PROD_STATE=$PROD_ROOT/state
PROD_PENDING=$PROD_STATE/pending
PROD_RUNTIME=$PROD_ROOT/runtime
PROD_CACHE=$PROD_RUNTIME/phase11a-benchmark/embedding-cache
PROD_SCHEMA=$PROD_RELEASE/config/note-schema.json
PROD_HOST=172.18.0.1
PROD_PORT=8765
PROD_ENV_SOURCE=/home/ragdehl/.config/odyssey/secrets.env
UNIT=odyssey-prod-runtime.service
UNIT_SOURCE=$PROD_RELEASE/deploy/$UNIT
UNIT_TARGET=/home/ragdehl/.config/systemd/user/$UNIT
OPERATOR_TARGET=/home/ragdehl/.local/bin/odyssey-prod
# PROD dependencies live outside both the release worktree and the human checkout.
PYTHON=/home/ragdehl/projects/odyssey-prod-venv/bin/python
DEPLOYED_COMMIT=$PROD_RUNTIME/deployed-commit

fail() {
  echo "odyssey-prod: $*" >&2
  exit 1
}

prod_git() {
  git --git-dir="$PROD_REPOSITORY/.git" "$@"
}

path_is_within() {
  local path=$1 root=$2
  case "$path" in
    "$root"|"$root"/*) return 0 ;;
    *) return 1 ;;
  esac
}

paths_do_not_overlap() {
  local first second
  first=$(realpath -m -- "$1")
  second=$(realpath -m -- "$2")
  ! path_is_within "$first" "$second" && ! path_is_within "$second" "$first"
}

environment_source_has_required_keys() {
  local source=$1
  [ -f "$source" ] || return 1
  awk '
    /^[[:space:]]*export[[:space:]]+OPENAI_API_KEY=/ { found = 1 }
    /^[[:space:]]*OPENAI_API_KEY=/ { found = 1 }
    END { exit !found }
  ' "$source"
}

guard() {
  local path resolved mode owner
  [ "$(id -un)" = "$PROD_USER" ] || fail "production operator must run as $PROD_USER"
  [ "$(realpath -m -- "$PROD_REPOSITORY")" = "$PROD_REPOSITORY" ] \
    || fail "production repository path is not fixed"
  [ -d "$PROD_REPOSITORY/.git" ] || fail "production Git directory is missing"
  [ "$(git --git-dir="$PROD_REPOSITORY/.git" rev-parse --is-bare-repository 2>/dev/null)" = true ] \
    || fail "production repository must be the shared bare Git store"
  [ "$(realpath -m -- "$PROD_RELEASE")" = "$PROD_RELEASE" ] \
    || fail "production release path is not fixed"
  [ "$PROD_RELEASE" != "$PROD_REPOSITORY" ] || fail "production release overlaps repository"
  for path in "$PROD_ROOT" "$PROD_VAULT" "$PROD_STATE" "$PROD_PENDING" "$PROD_RUNTIME" "$PROD_CACHE"; do
    resolved=$(realpath -m -- "$path")
    path_is_within "$resolved" "$PROD_ROOT" || fail "production path escapes root: $path -> $resolved"
    paths_do_not_overlap "$resolved" /data/odyssey-dev || fail "production path overlaps DEV root: $resolved"
  done
  [ -d "$PROD_VAULT" ] || fail "production vault is missing"
  [ -d "$PROD_STATE" ] || fail "production state root is missing"
  [ -d "$PROD_RUNTIME" ] || fail "production runtime root is missing"
  if [ "${1:-}" != deploy ]; then
    [ -f "$PROD_SCHEMA" ] || fail "production schema is missing from the release"
    [ -x "$PYTHON" ] || fail "production Python environment is missing"
    [ -f "$UNIT_SOURCE" ] || fail "production service definition is missing"
  fi
  [ -f "$PROD_ENV_SOURCE" ] || fail "production environment source is missing"
  owner=$(stat -c '%U:%G' "$PROD_ENV_SOURCE")
  mode=$(stat -c '%a' "$PROD_ENV_SOURCE")
  [ "$owner" = "$PROD_USER:$PROD_USER" ] || fail "production environment source owner is unsafe"
  [ "$mode" = 600 ] || fail "production environment source mode is unsafe"
  environment_source_has_required_keys "$PROD_ENV_SOURCE" \
    || fail "production environment source lacks required key names"
}

source_is_approved() {
  local requested=$1 resolved=$2
  [ -n "$requested" ] && [ "$requested" = "$resolved" ]
}

resolve_commit() {
  local git_dir=$1 requested=$2 resolved
  [ -n "$requested" ] || return 1
  resolved=$(git --git-dir="$git_dir" rev-parse --verify --end-of-options "$requested^{commit}") || return 1
  git --git-dir="$git_dir" cat-file -e "$resolved^{commit}" || return 1
  printf '%s\n' "$resolved"
}

materialize_release() {
  local git_dir=$1 release=$2 requested=$3 resolved dirty
  resolved=$(resolve_commit "$git_dir" "$requested") \
    || fail "requested release commit cannot be resolved: $requested"
  if [ -e "$release" ]; then
    [ -f "$release/.git" ] || fail "production release path is not an Odyssey Git worktree"
    git -C "$release" rev-parse HEAD >/dev/null 2>&1 \
      || fail "production release worktree is invalid"
    dirty=$(git -C "$release" status --porcelain 2>/dev/null) \
      || fail "production release worktree status is unavailable"
    [ -z "$dirty" ] || fail "production release worktree is dirty"
    git -C "$release" checkout --detach "$resolved" >/dev/null \
      || fail "could not update production release worktree"
  else
    git --git-dir="$git_dir" worktree add --detach "$release" "$resolved" >/dev/null \
      || fail "could not create production release worktree"
  fi
  [ "$(git -C "$release" rev-parse HEAD)" = "$resolved" ] \
    || fail "production release worktree commit verification failed"
  [ -z "$(git -C "$release" status --porcelain)" ] \
    || fail "production release worktree is not clean after materialization"
  printf '%s\n' "$resolved"
}

assert_reboot_persistence() {
  [ "$(loginctl show-user "$PROD_USER" -p Linger --value 2>/dev/null)" = yes ] \
    || fail "user-systemd linger is required for reboot-safe production deployment"
}

health_once() {
  curl --fail --silent --show-error --max-time 5 \
    "http://$PROD_HOST:$PROD_PORT/healthz" >/dev/null
}

wait_health() {
  local attempt
  for attempt in $(seq 1 60); do
    if health_once >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

provenance_state() {
  local current=$1 recorded=$2 dirty=$3 branch=$4
  if [ -z "$current" ] || [ -z "$recorded" ] || [ -n "$dirty" ] || [ -n "$branch" ]; then
    echo UNKNOWN
  elif [ "$current" = "$recorded" ]; then
    echo MATCH
  else
    echo DRIFT
  fi
}

deployment_provenance() {
  local current recorded branch dirty
  current=$(git -C "$PROD_RELEASE" rev-parse HEAD 2>/dev/null || true)
  recorded=$(cat "$DEPLOYED_COMMIT" 2>/dev/null || true)
  branch=$(git -C "$PROD_RELEASE" branch --show-current 2>/dev/null || true)
  dirty=$(git -C "$PROD_RELEASE" status --porcelain 2>/dev/null || true)
  provenance_state "$current" "$recorded" "$dirty" "$branch"
}

record_deployment() {
  local commit=$1 temporary
  temporary=$(mktemp "$PROD_RUNTIME/.deployed-commit.XXXXXX")
  printf '%s\n' "$commit" >"$temporary"
  chmod 640 "$temporary"
  mv -f "$temporary" "$DEPLOYED_COMMIT"
}

install_artifacts() {
  install -D -m 644 "$UNIT_SOURCE" "$UNIT_TARGET"
  install -d -m 755 /home/ragdehl/.local/bin
  ln -sfn "$PROD_RELEASE/scripts/odyssey-prod" "$OPERATOR_TARGET"
  systemctl --user daemon-reload
}

runtime() {
  guard
  exec "$PYTHON" -m odyssey_runtime
}

cloudflared_dns_diagnostic() {
  local host_dns container_state resolver_state error_state
  if getent ahosts cloudflare.com >/dev/null 2>&1; then host_dns=reachable; else host_dns=unavailable; fi
  container_state=$(docker inspect --format '{{.State.Status}}' cloudflared 2>/dev/null || echo absent)
  if [ "$container_state" = running ] \
    && docker cp cloudflared:/etc/resolv.conf - 2>/dev/null | tar -xOf - 2>/dev/null \
      | awk '/^nameserver[[:space:]]+/ { found = 1 } END { exit !found }'; then
    resolver_state=present
  else
    resolver_state=unavailable
  fi
  if docker logs --since 1h cloudflared 2>&1 \
    | grep -Eqi '127\\.0\\.0\\.11:53.*server misbehaving|lookup .*server misbehaving|quic.*timeout'; then
    error_state=observed
  else
    error_state=not-observed
  fi
  printf 'cloudflared_container=%s\nhost_dns=%s\ncloudflared_resolver=%s\ncloudflared_dns_or_quic_error=%s\n' \
    "$container_state" "$host_dns" "$resolver_state" "$error_state"
}

status() {
  local state health current branch dirty recorded provenance
  guard
  state=$(systemctl --user is-active "$UNIT" 2>/dev/null || true)
  current=$(git -C "$PROD_RELEASE" rev-parse HEAD 2>/dev/null || echo unavailable)
  branch=$(git -C "$PROD_RELEASE" branch --show-current 2>/dev/null || echo unavailable)
  dirty=$(git -C "$PROD_RELEASE" status --porcelain 2>/dev/null || true)
  recorded=$(cat "$DEPLOYED_COMMIT" 2>/dev/null || echo none)
  if health_once >/dev/null 2>&1; then health=healthy; else health=unhealthy; fi
  provenance=$(deployment_provenance)
  printf 'environment=PROD\nruntime_service=%s\nruntime_address=%s:%s\nruntime_health=%s\ndata_root=%s\nrepository=%s\nrelease=%s\ndeployed_commit=%s\nchecked_out_commit=%s\nbranch=%s\ncheckout_clean=%s\nsource_provenance=%s\n' \
    "$state" "$PROD_HOST" "$PROD_PORT" "$health" "$PROD_ROOT" "$PROD_REPOSITORY" "$PROD_RELEASE" "$recorded" \
    "$current" "$branch" "$([ -z "$dirty" ] && echo yes || echo no)" "$provenance"
  cloudflared_dns_diagnostic
}

deploy() {
  local requested_commit resolved_commit
  requested_commit=${1:-}
  guard deploy
  [ "$#" -eq 1 ] || fail "production deploy requires exactly one commit or commit-resolving ref"
  assert_reboot_persistence
  resolved_commit=$(materialize_release "$PROD_REPOSITORY/.git" "$PROD_RELEASE" "$requested_commit")
  install_artifacts
  systemctl --user enable "$UNIT"
  systemctl --user restart "$UNIT"
  wait_health || fail "production runtime did not become healthy on $PROD_HOST:$PROD_PORT"
  record_deployment "$resolved_commit"
  printf 'deployed_commit=%s\n' "$resolved_commit"
}

restart() {
  guard
  [ "$(deployment_provenance)" = MATCH ] \
    || fail "production source provenance is not MATCH; run approved odyssey-prod deploy"
  systemctl --user restart "$UNIT"
  wait_health || fail "production runtime did not become healthy on $PROD_HOST:$PROD_PORT"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  case "${1:-status}" in
    status) status ;;
    deploy) deploy ;;
    restart) restart ;;
    runtime) runtime ;;
    *) fail "usage: odyssey-prod {status|deploy COMMIT|restart}" ;;
  esac
fi
