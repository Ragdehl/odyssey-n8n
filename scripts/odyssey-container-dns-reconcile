#!/usr/bin/env bash
set -euo pipefail

# Reconcile only the two production containers whose Docker DNS is part of the
# public Odyssey boundary. This guard is intentionally independent of odyssey-prod.
COMPOSE_FILE=/home/ragdehl/docker/n8n/compose.yaml
COMPOSE_PROJECT=n8n
TARGET_SERVICES=(cloudflared n8n)
HOST_DNS_PROBES=(cloudflare.com api.openai.com)
N8N_HEALTH_URL=http://127.0.0.1:18780/healthz
# Leave 15 seconds for terminal evidence/systemd cleanup within TimeoutStartSec=180.
GUARD_WINDOW_SECONDS=165
GUARD_DEADLINE=0
READINESS_DELAY_SECONDS=2
STARTUP_GRACE_ATTEMPTS=30
STARTUP_GRACE_DELAY_SECONDS=2
CLOUDFLARED_STARTUP_STATE=ready
N8N_STARTUP_STATE=ready

ASSESS_HEALTHY=0
ASSESS_STALE=10
ASSESS_FAILED=20

log() {
  local level=$1 message=$2
  printf 'odyssey-container-dns[%s] %s\n' "$level" "$message" >&2
}

docker_cmd() {
  bounded_command 5 docker "$@"
}

bounded_command() {
  local limit=$1 remaining
  shift
  if [ "$GUARD_DEADLINE" -gt 0 ]; then
    remaining=$((GUARD_DEADLINE - SECONDS))
    [ "$remaining" -gt 0 ] || return 124
    [ "$limit" -le "$remaining" ] || limit=$remaining
  fi
  timeout --signal=TERM --kill-after=1 "$limit" "$@"
}

compose_cmd() {
  docker_cmd compose --file "$COMPOSE_FILE" "$@"
}

is_target_service() {
  local service=$1 target
  for target in "${TARGET_SERVICES[@]}"; do
    [ "$service" = "$target" ] && return 0
  done
  return 1
}

host_resolvers() {
  awk '$1 == "nameserver" && $2 !~ /^127\./ && $2 != "::1" { print $2 }' /etc/resolv.conf \
    | python3 -c 'import ipaddress, sys; print("\n".join(sorted({str(ipaddress.ip_address(line.strip())) for line in sys.stdin})))'
}

host_dns_healthy() {
  local probe expected
  expected=$(host_resolvers) || return 1
  [ -n "$expected" ] || return 1
  for probe in "${HOST_DNS_PROBES[@]}"; do
    bounded_command 5 getent ahosts "$probe" >/dev/null 2>&1 || return 1
  done
}

container_external_resolvers() {
  local service=$1
  docker_cmd cp "$service:/etc/resolv.conf" - 2>/dev/null \
    | tar -xOf - 2>/dev/null \
    | python3 -c '
import ipaddress, re, sys
text = sys.stdin.read()
match = re.search(r"^# ExtServers: \[(.*)\]$", text, re.M)
if not match:
    raise SystemExit(1)
tokens = re.split(r"[,\s]+", match[1].strip())
addresses = []
for token in tokens:
    item = re.fullmatch(r"host\(([^()]+)\)", token)
    if not item:
        raise SystemExit(1)
    addresses.append(str(ipaddress.ip_address(item[1])))
print("\n".join(sorted(set(addresses))))
'
}

resolvers_match_host() {
  local service=$1 expected actual
  expected=$(host_resolvers) || return 2
  actual=$(container_external_resolvers "$service") || return 2
  [ -n "$expected" ] && [ -n "$actual" ] && [ "$expected" = "$actual" ]
}

container_identity_valid() {
  local service=$1 service_label project_label compose_label
  service_label=$(docker_cmd inspect --format '{{index .Config.Labels "com.docker.compose.service"}}' "$service") || return 1
  project_label=$(docker_cmd inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$service") || return 1
  compose_label=$(docker_cmd inspect --format '{{index .Config.Labels "com.docker.compose.project.config_files"}}' "$service") || return 1
  [ "$service_label" = "$service" ] \
    && [ "$project_label" = "$COMPOSE_PROJECT" ] \
    && [ "$compose_label" = "$COMPOSE_FILE" ]
}

container_running() {
  local service=$1
  [ "$(docker_cmd inspect --format '{{.State.Status}}' "$service" 2>/dev/null)" = running ]
}

validate_scope() {
  local services service
  services=$(compose_cmd config --services | sort) || {
    log FAILED 'compose identity unavailable; no recovery'
    return 1
  }
  [ "$services" = $'cloudflared\nn8n' ] || {
    log FAILED "compose identity mismatch services=$(printf '%q' "$services")"
    return 1
  }
  for service in "${TARGET_SERVICES[@]}"; do
    if ! container_identity_valid "$service"; then
      log FAILED "container identity mismatch service=$service"
      return 1
    fi
  done
}

n8n_dns_ready() {
  docker_cmd exec n8n node --eval \
    'require("node:dns").lookup("api.openai.com", (error) => process.exit(error ? 1 : 0))' \
    >/dev/null 2>&1
}

n8n_service_ready() {
  n8n_dns_ready \
    && curl --fail --silent --show-error --max-time 3 "$N8N_HEALTH_URL" >/dev/null 2>&1
}

n8n_mount_fingerprint() {
  # Include bind sources, volume identity, access and propagation, not environment.
  # JSON escaping preserves unusual path characters; one actual line per mount.
  docker_cmd inspect --format '{{json .Mounts}}' n8n | python3 -c '
import json, sys
mounts = json.load(sys.stdin)
if not isinstance(mounts, list) or not mounts:
    raise SystemExit("missing mount evidence")
normalized = []
for mount in mounts:
    for required in ("Type", "Source", "Destination", "RW"):
        if required not in mount:
            raise SystemExit("incomplete mount evidence")
    for optional in ("Name", "Driver", "Mode", "Propagation"):
        mount.setdefault(optional, "")
    mount["Mode"] = ",".join(sorted(filter(None, mount["Mode"].split(","))))
    normalized.append(json.dumps(mount, sort_keys=True, separators=(",", ":")))
print("\n".join(sorted(normalized)))
'
}

mount_diagnostics() {
  local before=$1 after=$2 line count=0
  # At most 16 changed normalized mount records; never dump inspect/env/config.
  while IFS= read -r line; do
    count=$((count + 1))
    [ "$count" -le 16 ] || { log DIAGNOSTIC 'service=n8n mount_diff=truncated'; break; }
    log DIAGNOSTIC "service=n8n mount_diff=$(printf '%q' "${line:0:1024}")"
  done < <(diff --label before --label after -u <(printf '%s\n' "$before") <(printf '%s\n' "$after") || true)
}

cloudflared_started_at() {
  docker_cmd inspect --format '{{.State.StartedAt}}' cloudflared
}

cloudflared_logs() {
  local started_at=$1
  docker_cmd logs --since "$started_at" cloudflared 2>&1
}

cloudflared_dns_error() {
  local started_at=$1
  cloudflared_logs "$started_at" \
    | grep -Ei '127\.0\.0\.11:53.*server misbehaving|lookup .*server misbehaving|failed to refresh DNS|lookup .*i/o timeout' >/dev/null
}

cloudflared_registered() {
  local started_at=$1
  [ "$(cloudflared_logs "$started_at" | grep -c 'Registered tunnel connection' || true)" -ge 1 ]
}

cloudflared_registered_after_last_dns_error() {
  local ordering
  ordering=$(cloudflared_event_order "$1") || return 1
  [[ "$ordering" == *'registration_ready=PASS' ]]
}

cloudflared_event_order() {
  cloudflared_logs "$1" | awk '
    { lower=tolower($0) }
    lower ~ /127\.0\.0\.11:53.*server misbehaving|lookup .*server misbehaving|failed to refresh dns|lookup .*i\/o timeout/ { dns=NR }
    /Registered tunnel connection/ { registered=NR }
    END { printf "last_dns_error=%d last_registration=%d registration_ready=%s\n", dns, registered, (registered > dns ? "PASS" : "FAIL") }
  '
}

cloudflared_service_ready() {
  local started_at
  started_at=$(cloudflared_started_at)
  resolvers_match_host cloudflared \
    && cloudflared_registered_after_last_dns_error "$started_at"
}

target_ready() {
  local service=$1 expected observed match=FAIL dns=FAIL health=000 ordering started_at
  local resolver_rc=0 dns_rc=0 health_rc=0
  expected=$(host_resolvers) || expected=''
  observed=$(container_external_resolvers "$service") || { resolver_rc=$?; observed=''; }
  if [ -n "$expected" ] && [ -n "$observed" ] && [ "$expected" = "$observed" ]; then match=PASS; fi
  READINESS_EVIDENCE="expected=$(printf '%q' "$expected") observed=$(printf '%q' "$observed") resolver_match=$match resolver_read_rc=$resolver_rc"
  case "$service" in
    cloudflared)
      started_at=$(cloudflared_started_at) || started_at=''
      ordering='logs=unavailable registration_ready=FAIL'
      if [ -n "$started_at" ]; then
        ordering=$(cloudflared_event_order "$started_at") || ordering='logs=unavailable registration_ready=FAIL'
      fi
      READINESS_EVIDENCE+=" $ordering"
      [ "$match" = PASS ] && [[ "$ordering" == *'registration_ready=PASS' ]]
      ;;
    n8n)
      if n8n_dns_ready; then dns=PASS; else dns_rc=$?; fi
      health=$(bounded_command 3 curl --silent --output /dev/null --write-out '%{http_code}' --max-time 3 "$N8N_HEALTH_URL") || { health_rc=$?; health=000; }
      READINESS_EVIDENCE+=" dns_api_openai=$dns healthz=$health dns_rc=$dns_rc healthz_rc=$health_rc mounts=${MOUNT_RESULT:-not_compared}"
      [ "$match" = PASS ] && [ "$dns" = PASS ] && [ "$health" = 200 ]
      ;;
    *) return 1 ;;
  esac
}

readiness_diagnostics() {
  target_ready "$1" || true
  log DIAGNOSTIC "service=$1 $READINESS_EVIDENCE"
}

assess_target() {
  local service=$1 started_at resolver_code
  if resolvers_match_host "$service"; then
    resolver_code=0
  else
    resolver_code=$?
  fi
  if [ "$resolver_code" -eq 2 ]; then
    REASON='container resolver evidence unavailable or unparseable; no stale DNS proof'
    return "$ASSESS_FAILED"
  fi
  log DIAGNOSTIC "service=$service assessment_resolver_match=$resolver_code expected=$(printf '%q' "$(host_resolvers)") observed=$(printf '%q' "$(container_external_resolvers "$service")")"
  case "$service" in
    n8n)
      if [ "$resolver_code" -ne 0 ]; then
        REASON="container resolver differs from current host resolver"
        return "$ASSESS_STALE"
      fi
      if ! n8n_dns_ready; then
        REASON="n8n cannot resolve api.openai.com while host DNS is healthy"
        return "$ASSESS_STALE"
      fi
      if ! curl --fail --silent --show-error --max-time 3 "$N8N_HEALTH_URL" >/dev/null 2>&1; then
        REASON="n8n health endpoint is not ready without DNS evidence"
        return "$ASSESS_FAILED"
      fi
      ;;
    cloudflared)
      started_at=$(cloudflared_started_at)
      if [ "$resolver_code" -ne 0 ]; then
        REASON="container resolver differs from current host resolver"
        return "$ASSESS_STALE"
      fi
      if cloudflared_dns_error "$started_at"; then
        if ! cloudflared_registered_after_last_dns_error "$started_at"; then
          REASON="cloudflared logs show DNS resolution failure without later tunnel registration"
          return "$ASSESS_STALE"
        fi
      fi
      if ! cloudflared_registered "$started_at"; then
        REASON="cloudflared has no registered tunnel connection"
        return "$ASSESS_FAILED"
      fi
      ;;
    *)
      REASON="unexpected service"
      return "$ASSESS_FAILED"
      ;;
  esac
  return "$ASSESS_HEALTHY"
}

compose_recreate() {
  local service=$1
  is_target_service "$service" || {
    log FAILED "refusing unexpected service=$service"
    return 1
  }
  # Compose gets a longer command allowance, still capped by the shared deadline.
  bounded_command 45 docker compose --file "$COMPOSE_FILE" up -d --no-deps --force-recreate --pull never "$service"
}

wait_for_target() {
  local service=$1
  READINESS_EVIDENCE='probe=not_completed'
  while [ "$SECONDS" -lt "$GUARD_DEADLINE" ]; do
    if target_ready "$service"; then
      return 0
    fi
    sleep "$READINESS_DELAY_SECONDS"
  done
  log DIAGNOSTIC "service=$service readiness=timeout $READINESS_EVIDENCE"
  return 1
}

wait_for_startup_readiness() {
  local attempt started_at
  CLOUDFLARED_STARTUP_STATE=waiting
  N8N_STARTUP_STATE=waiting
  for attempt in $(seq 1 "$STARTUP_GRACE_ATTEMPTS"); do
    [ "$SECONDS" -lt "$GUARD_DEADLINE" ] || break
    # A target's terminal state must not suppress the other target's evidence.
    if [ "$CLOUDFLARED_STARTUP_STATE" = waiting ]; then
      if ! container_running cloudflared; then
        log WAITING "service=cloudflared container is still starting (attempt=$attempt/$STARTUP_GRACE_ATTEMPTS)"
      elif ! resolvers_match_host cloudflared; then
        CLOUDFLARED_STARTUP_STATE=stale
      else
        started_at=$(cloudflared_started_at)
        if cloudflared_registered "$started_at"; then
          CLOUDFLARED_STARTUP_STATE=ready
        else
          log WAITING "service=cloudflared awaiting initial tunnel registration (attempt=$attempt/$STARTUP_GRACE_ATTEMPTS)"
        fi
      fi
    fi

    if [ "$N8N_STARTUP_STATE" = waiting ]; then
      if ! container_running n8n; then
        log WAITING "service=n8n container is still starting (attempt=$attempt/$STARTUP_GRACE_ATTEMPTS)"
      elif ! resolvers_match_host n8n; then
        N8N_STARTUP_STATE=stale
      elif n8n_service_ready; then
        N8N_STARTUP_STATE=ready
      else
        log WAITING "service=n8n awaiting resolver, DNS, and health readiness (attempt=$attempt/$STARTUP_GRACE_ATTEMPTS)"
      fi
    fi

    if [ "$CLOUDFLARED_STARTUP_STATE" != waiting ] \
      && [ "$N8N_STARTUP_STATE" != waiting ]; then
      return 0
    fi
    [ "$attempt" -lt "$STARTUP_GRACE_ATTEMPTS" ] && sleep "$STARTUP_GRACE_DELAY_SECONDS"
  done

  if [ "$CLOUDFLARED_STARTUP_STATE" = waiting ]; then
    CLOUDFLARED_STARTUP_STATE=timeout
  fi
  if [ "$N8N_STARTUP_STATE" = waiting ]; then
    N8N_STARTUP_STATE=timeout
  fi
  return 0
}

run_guard() {
  local service code overall=0 n8n_mount_before n8n_mount_after
  declare -A recover=()
  declare -A reasons=()
  declare -A readiness_jobs=()
  GUARD_DEADLINE=$((SECONDS + GUARD_WINDOW_SECONDS))

  validate_scope || return 1
  if ! host_dns_healthy; then
    log FAILED 'host DNS is unhealthy; no service will be recreated'
    return 1
  fi
  if ! wait_for_startup_readiness; then
    log FAILED 'expected production containers did not reach bounded startup readiness; no service will be recreated'
    return 1
  fi

  for service in "${TARGET_SERVICES[@]}"; do
    if [ "$service" = cloudflared ] && [ "$CLOUDFLARED_STARTUP_STATE" = timeout ]; then
      readiness_diagnostics "$service"
      log FAILED 'service=cloudflared reason=cloudflared startup readiness grace expired; no recreation'
      overall=1
      continue
    fi
    if [ "$service" = n8n ] && [ "$N8N_STARTUP_STATE" = timeout ]; then
      readiness_diagnostics "$service"
      log FAILED 'service=n8n reason=n8n startup readiness grace expired without stale DNS proof; no recreation'
      overall=1
      continue
    fi
    if assess_target "$service"; then
      log HEALTHY "service=$service"
      continue
    else
      code=$?
    fi
    case "$code" in
      "$ASSESS_STALE")
        recover["$service"]=1
        reasons["$service"]=$REASON
        ;;
      *)
        readiness_diagnostics "$service"
        log FAILED "service=$service reason=$REASON"
        overall=1
        ;;
    esac
  done

  for service in "${TARGET_SERVICES[@]}"; do
    [ "${recover[$service]:-0}" = 1 ] || continue
    n8n_mount_before=''
    if [ "$service" = n8n ]; then
      if ! n8n_mount_before=$(n8n_mount_fingerprint); then
        MOUNT_RESULT=unavailable
        readiness_diagnostics n8n
        log FAILED 'service=n8n mounts=unavailable before recreation; no recreation'
        overall=1
        continue
      fi
    fi
    if ! host_dns_healthy; then
      log FAILED "service=$service host DNS unhealthy before recreation; no recreation"
      overall=1
      continue
    fi
    log RECOVERING "service=$service reason=${reasons[$service]}"
    if ! compose_recreate "$service"; then
      log FAILED "service=$service recreation failed; no retry or escalation"
      overall=1
      continue
    fi
    if [ "$service" = n8n ]; then
      if ! n8n_mount_after=$(n8n_mount_fingerprint); then
        MOUNT_RESULT=unavailable
        readiness_diagnostics n8n
        log FAILED 'service=n8n mounts=unavailable after recreation; no retry or escalation'
        overall=1
        continue
      fi
      if [ "$n8n_mount_before" != "$n8n_mount_after" ]; then
        MOUNT_RESULT=FAIL
        target_ready n8n || true
        log DIAGNOSTIC "service=n8n $READINESS_EVIDENCE"
        mount_diagnostics "$n8n_mount_before" "$n8n_mount_after"
        log FAILED 'service=n8n mount configuration changed after recreation; no retry or escalation'
        overall=1
        continue
      fi
      MOUNT_RESULT=PASS
    fi
    # Only readiness overlaps. Mutations remain sequential and once per target;
    # a slow cloudflared startup cannot consume n8n's recovery opportunity.
    (
      if wait_for_target "$service"; then
        log RECOVERED "service=$service reason=${reasons[$service]}"
      else
        log FAILED "service=$service remains unhealthy after one recovery attempt; no retry or escalation"
        exit 1
      fi
    ) &
    readiness_jobs["$service"]=$!
  done
  for service in "${TARGET_SERVICES[@]}"; do
    [ -n "${readiness_jobs[$service]:-}" ] || continue
    wait "${readiness_jobs[$service]}" || overall=1
  done
  return "$overall"
}

main() {
  [ "$#" -eq 0 ] || { log FAILED 'guard accepts no arguments'; return 1; }
  run_guard
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
