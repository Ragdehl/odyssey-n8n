{
  "version": "3.0.3",
  "examples": [
    {
      "id": "teach-domain-date",
      "request": "What purchases did I make in July?",
      "result": {
        "outcome": "PLAN",
        "actions": [
          {
            "kind": "retrieve",
            "result_shape": "collection",
            "plan": {
              "entity": null,
              "query": "purchases I made in July",
              "type": null,
              "filters": [],
              "link_scope": null,
              "self_target": null,
              "relational_reference": null
            }
          }
        ],
        "limitations": [],
        "clarification_code": null,
        "presentation_intent": "answer"
      },
      "lesson": "July is purchase event time, not note creation time, so preserve it in the lossless query rather than using lifecycle filters. Because the user asks to enumerate the purchases themselves, use result_shape=collection with no direct selector and let Core discover grounded evidence; ordinary facts or synthesis about one subject remain single."
    },
    {
      "id": "teach-lifecycle-date",
      "request": "Which notes did I create in July 2026?",
      "result": {
        "outcome": "PLAN",
        "actions": [
          {
            "kind": "retrieve",
            "plan": {
              "entity": null,
              "query": "notes I created in July 2026",
              "type": null,
              "filters": [
                {
                  "field": "created_at",
                  "op": "gte",
                  "value": "2026-07-01T00:00:00+02:00"
                },
                {
                  "field": "created_at",
                  "op": "lt",
                  "value": "2026-08-01T00:00:00+02:00"
                }
              ],
              "link_scope": null
            }
          }
        ],
        "limitations": [],
        "clarification_code": null
      },
      "lesson": "The user explicitly asks about Odyssey note creation, so created_at is correct."
    },
    {
      "id": "teach-independent-or",
      "request": "Show Odyssey notes I created on September 8, 2026 OR n8n notes I modified on September 9, 2026.",
      "result": {
        "outcome": "PLAN",
        "actions": [
          {
            "kind": "retrieve",
            "plan": {
              "entity": null,
              "query": "Odyssey notes created on September 8, 2026",
              "type": null,
              "filters": [
                {
                  "field": "created_at",
                  "op": "gte",
                  "value": "2026-09-08T00:00:00+02:00"
                },
                {
                  "field": "created_at",
                  "op": "lt",
                  "value": "2026-09-09T00:00:00+02:00"
                }
              ],
              "link_scope": null
            }
          },
          {
            "kind": "retrieve",
            "plan": {
              "entity": null,
              "query": "n8n notes modified on September 9, 2026",
              "type": null,
              "filters": [
                {
                  "field": "updated_at",
                  "op": "gte",
                  "value": "2026-09-09T00:00:00+02:00"
                },
                {
                  "field": "updated_at",
                  "op": "lt",
                  "value": "2026-09-10T00:00:00+02:00"
                }
              ],
              "link_scope": null
            }
          }
        ],
        "limitations": [],
        "clarification_code": null
      },
      "lesson": "Each OR branch has its own candidate set and lifecycle filter; putting both filters on one selection would mean AND and lose results."
    },
    {
      "id": "teach-clarify",
      "request": "qzxqzx",
      "result": {
        "outcome": "CLARIFY",
        "actions": null,
        "limitations": null,
        "clarification_code": "UNRECOGNIZED_REQUEST"
      },
      "lesson": "Meaningless input has no safe action and is not delegated."
    },
    {
      "id": "teach-escalate",
      "request": "Correct whichever of my old project notes are probably inconsistent, but do not ask me which ones.",
      "result": {
        "outcome": "ESCALATE",
        "actions": null,
        "limitations": null,
        "clarification_code": null
      },
      "lesson": "An understandable mutation with unresolved scope and truth must escalate instead of inventing targets or corrections."
    },
    {
      "id": "teach-delegation-selection",
      "request": "Calculate how many documents mention Odyssey.",
      "result": {
        "outcome": "PLAN",
        "actions": [
          {
            "kind": "delegate",
            "request": "calculate how many documents mention Odyssey",
            "selection": {
              "entity": null,
              "query": "documents that mention Odyssey",
              "type": "document",
              "filters": [],
              "link_scope": null
            }
          }
        ],
        "limitations": [],
        "clarification_code": null
      },
      "lesson": "The aggregate operation is delegated while its Odyssey candidate selection remains explicit; the planner does not calculate or execute it."
    },
    {
      "id": "teach-write-target",
      "request": "Remember that Marta lives in Lyon and works at Thales.",
      "result": {
        "outcome": "PLAN",
        "actions": [
          {
            "kind": "write",
            "operations": [
              {
                "target": {
                  "description": "Marta",
                  "binding": "described",
                  "direct_name": "Marta",
                  "note_type": "person",
                  "filters": [],
                  "candidate_scope": null
                },
                "apply_to": "one",
                "intent": "record",
                "facts": [
                  {
                    "parts": [
                      {
                        "kind": "literal",
                        "text": "Lives in Lyon."
                      }
                    ]
                  },
                  {
                    "parts": [
                      {
                        "kind": "literal",
                        "text": "Works at Thales."
                      }
                    ]
                  }
                ],
                "properties": [],
                "tag_changes": [],
                "destination_type": null
              }
            ]
          }
        ],
        "limitations": [],
        "clarification_code": null,
        "presentation_intent": "answer"
      },
      "lesson": "One semantic operation keeps independent durable facts separate, while Core derives reference and unit mechanics after target resolution."
    },
    {
      "id": "teach-source-relationship-participants",
      "request": "Remember that Hana and Luis joined me for a museum visit.",
      "result": {
        "outcome": "PLAN",
        "actions": [
          {
            "kind": "write",
            "operations": [
              {
                "target": {
                  "description": "the authenticated human",
                  "binding": "self",
                  "direct_name": null,
                  "note_type": "person",
                  "filters": [],
                  "candidate_scope": null
                },
                "apply_to": "one",
                "intent": "record",
                "facts": [
                  {
                    "parts": [
                      {
                        "kind": "identity",
                        "text": "Hana",
                        "identity": {
                          "description": "Hana",
                          "binding": "described",
                          "direct_name": "Hana",
                          "note_type": "person",
                          "filters": [],
                          "candidate_scope": null
                        }
                      },
                      {
                        "kind": "literal",
                        "text": " and "
                      },
                      {
                        "kind": "identity",
                        "text": "Luis",
                        "identity": {
                          "description": "Luis",
                          "binding": "described",
                          "direct_name": "Luis",
                          "note_type": "person",
                          "filters": [],
                          "candidate_scope": null
                        }
                      },
                      {
                        "kind": "literal",
                        "text": " joined me for a museum visit."
                      }
                    ]
                  }
                ],
                "properties": [],
                "tag_changes": [],
                "destination_type": null
              }
            ]
          }
        ],
        "limitations": [],
        "clarification_code": null,
        "presentation_intent": "answer"
      },
      "lesson": "The authenticated human owns this one relationship fact. Keep one self-targeted operation and encode each safely selectable participant as an identity part; do not create participant-targeted operations."
    },
    {
      "id": "teach-relational-target-with-described-reference",
      "request": "Remember that my mentor who works remotely attended a conference with the designer who lives in Porto.",
      "result": {
        "outcome": "PLAN",
        "actions": [
          {
            "kind": "write",
            "operations": [
              {
                "target": {
                  "description": "my mentor who works remotely",
                  "binding": "described",
                  "direct_name": null,
                  "note_type": "person",
                  "filters": [],
                  "candidate_scope": {
                    "source": {
                      "kind": "SELF"
                    },
                    "member_query": "my mentor",
                    "extent": "one_member"
                  }
                },
                "apply_to": "one",
                "intent": "record",
                "facts": [
                  {
                    "parts": [
                      {
                        "kind": "literal",
                        "text": "Attended a conference with "
                      },
                      {
                        "kind": "identity",
                        "text": "the designer who lives in Porto",
                        "identity": {
                          "description": "the designer who lives in Porto",
                          "binding": "described",
                          "direct_name": null,
                          "note_type": "person",
                          "filters": [],
                          "candidate_scope": null
                        }
                      },
                      {
                        "kind": "literal",
                        "text": "."
                      }
                    ]
                  }
                ],
                "properties": [],
                "tag_changes": [],
                "destination_type": null
              }
            ]
          }
        ],
        "limitations": [],
        "clarification_code": null,
        "presentation_intent": "answer"
      },
      "lesson": "A relationship-bounded target and a separately described participant are independent identities. Keep the full target qualifier in target.description, bound only the target candidate set to SELF, and encode the other participant as an identity part in the fact."
    },
    {
      "id": "teach-relational-complete-set-write",
      "request": "In the existing Atlas project note, record that everyone listed as a member previously worked for the same company.",
      "result": {
        "outcome": "PLAN",
        "actions": [
          {
            "kind": "write",
            "operations": [
              {
                "target": {
                  "description": "everyone listed as a member in the existing Atlas project note",
                  "binding": "described",
                  "direct_name": null,
                  "note_type": null,
                  "filters": [],
                  "candidate_scope": {
                    "source": {
                      "kind": "EXISTING_DESCRIPTION",
                      "description": "the existing Atlas project note"
                    },
                    "member_query": "everyone listed as a member in the existing Atlas project note",
                    "extent": "complete_set"
                  }
                },
                "apply_to": "one",
                "intent": "record",
                "facts": [
                  {
                    "parts": [
                      {
                        "kind": "literal",
                        "text": "Everyone listed as a member in the existing Atlas project note previously worked for the same company."
                      }
                    ]
                  }
                ],
                "properties": [],
                "tag_changes": [],
                "destination_type": null
              }
            ]
          }
        ],
        "limitations": [],
        "clarification_code": null,
        "presentation_intent": "answer"
      },
      "lesson": "Use candidate_scope with an existing source only when the request actually identifies an existing canonical source. For a complete current member set, use extent=complete_set and apply_to=one; do not turn mere event context into an invented source."
    }
  ]
}
